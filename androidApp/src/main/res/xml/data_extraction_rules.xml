<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device, neither by cloud backup nor by
     device-to-device transfer. The JWTs live in EncryptedSharedPreferences whose
     Keystore key never moves, so a transferred copy would be unreadable anyway
     (audit M5). allowBackup="false" covers Android 11 and below. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
